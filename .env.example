# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file that contains real secrets.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000
BACKEND_STATIC_TOKEN=change-me
BACKEND_APIKEY=change-me

# ---------------------------------------------------------------------------
# NextAuth.js
# Docs: https://next-auth.js.org/configuration/options
# Generate NEXTAUTH_SECRET: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET is read implicitly by next-auth from the environment.
# Set it in .env.local — never commit it.

# ---------------------------------------------------------------------------
# Public vars (exposed to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=BRL

# ---------------------------------------------------------------------------
# Session / cookie config (optional — defaults shown)
# ---------------------------------------------------------------------------
ACCESS_COOKIE_NAME=tc-access
REFRESH_COOKIE_NAME=tc-refresh
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_CHECK_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Stripe (optional — payment features disabled when absent)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_change-me
# STRIPE_PRICE_ID=price_change-me

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# ADMIN_CLEANUP_KEY=change-me
