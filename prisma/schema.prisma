generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model configurations {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model ingredient_price_observations {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  user_id Json?

  @@index([user_id], map: "user_id_1")
}

model ingredients {
  /// Field referred in an index, but found no data to define the type.
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  name    Json?
  /// Field referred in an index, but found no data to define the type.
  user_id Json?

  @@index([user_id], map: "user_id_1")
  @@index([user_id, name], map: "user_id_1_name_1")
  @@index([user_id, id], map: "user_id_1__id_1")
}

